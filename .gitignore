# Environment variables — never commit secrets
.env
.env.local
.env.production

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
*.egg-info/
dist/
build/
.pytest_cache/

# Node / Frontend
node_modules/
frontend/dist/
frontend/.vite/

# Database dumps — may contain live user data, never commit
*.sql
*.dump
# Schema and migrations are source, not dumps, and must stay tracked.
!schema.sql
!migrations/
!migrations/*.sql

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
