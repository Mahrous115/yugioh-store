# Copy this file to .env and fill in your values.
# In a container none of this file is used — the platform injects real
# environment variables and load_dotenv() becomes a no-op.

# ─── Required. The app fails at import if either is missing ─────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-secret-key-here

# ─── Networking ─────────────────────────────────────────────────────────────

# Port to listen on. Azure Container Apps sets this; 8000 is the local default.
# The server always binds 0.0.0.0 — 127.0.0.1 is unreachable from outside a
# container, so a probe against it never goes healthy.
# PORT=8000

# CORS allowlist, comma-separated exact origins. Add deployed frontends here;
# http://localhost:5173 is always allowed regardless.
#   CORS_ALLOWED_ORIGINS=https://app.example.com,https://duel-market.azurewebsites.net
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Older name for the same thing. Still honoured and merged with the above, so
# existing configs keep working. Prefer CORS_ALLOWED_ORIGINS for new setups.
# FRONTEND_URL=http://localhost:5173

# Preview deployments get a generated hostname per commit, so they are matched by
# pattern. Both of these default to "no preview origins allowed".
#
# Convenience: builds the standard Vercel pattern for one project, i.e.
#   https://<slug>.vercel.app and https://<slug>-<anything>.vercel.app
# There is deliberately no default — this used to be hardcoded to a specific
# project's slug in main.py, which is deployment config living in source.
VERCEL_PROJECT_SLUG=

# Escape hatch: a full regex, for any host that is not Vercel. Takes precedence
# over VERCEL_PROJECT_SLUG. Anchor it yourself (^...$) and require https, or you
# will match things like https://<yours>.example.com.evil.com
#   CORS_PREVIEW_ORIGIN_REGEX=^https://myapp-[a-z0-9]+\.azurestaticapps\.net$
# CORS_PREVIEW_ORIGIN_REGEX=

# ─── Observability ──────────────────────────────────────────────────────────

# Root log level. Logs always go to stdout; nothing is written to disk.
# LOG_LEVEL=INFO

# ─── Behaviour ──────────────────────────────────────────────────────────────

# Interactive API docs (/docs, /redoc, /openapi.json). Off unless explicitly
# enabled — they publish a full map of the API surface. Handy locally, pure
# reconnaissance value in production. Only 1/true/yes/on open them.
ENABLE_DOCS=true

# Cosmetic; shown in the OpenAPI document.
# API_TITLE=Yu-Gi-Oh! Duel Market API
# API_VERSION=1.0.0

# Rate limits, requests per minute per caller (per session token when
# authenticated, per IP otherwise). Order creation is tightest because every
# call writes a row. Defaults shown; override to tighten without a code change.
# RATE_LIMIT_ORDERS_PER_MIN=5
# RATE_LIMIT_WISHLIST_PER_MIN=10
# RATE_LIMIT_LISTINGS_PER_MIN=30
# RATE_LIMIT_DEFAULT_PER_MIN=300

# ─── Tests only. Never set these in the container ───────────────────────────
#
# These three are read by tests/conftest.py at import. The first two use
# os.environ[...] with no default, so pytest dies during *collection* if they
# are missing — the error names the variable but not the fact that it is
# test-only, which reads as an app misconfiguration. They are uncommented
# below on purpose: a copy of this file should fail loudly, not subtly.

# Direct Postgres connection; the suite asserts on RLS policies and grants.
# Use the session pooler string, not db.<ref>.supabase.co (IPv6-only).
# REQUIRED to run the suite. Contains the database password — this grants far
# more than the app itself needs, which is why it must not reach the image.
SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# The public anon key — what a browser would use. The privilege-escalation and
# order-integrity tests must attack with exactly that key rather than the
# service key, or they would prove nothing.
# REQUIRED to run the suite. conftest.py also loads ../frontend/.env, so it can
# live there instead; whichever is set first wins, as load_dotenv never
# overrides an already-set variable. Not a secret (it ships in the JS bundle),
# but it is still a credential and still has no business in this image.
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Which backend the suite drives. Defaults to http://127.0.0.1:8000, so leave it
# unset unless you are running the server on another port or host.
# API_URL=http://127.0.0.1:8000
