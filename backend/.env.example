# Copy this file to .env and fill in your values
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# CORS allowlist. Comma-separated for multiple fixed origins, e.g.
#   FRONTEND_URL=http://localhost:5173,https://your-app.vercel.app
# Until 2026-08-04 this was configured but read by nothing, because CORS was
# hardcoded to allow_origins=["*"]. It is now the actual allowlist.
FRONTEND_URL=http://localhost:5173

# Vercel preview deployments get a generated hostname per commit, so they are
# matched by pattern rather than listed. This is the project slug in those
# hostnames: https://<slug>-<hash>.vercel.app
VERCEL_PROJECT_SLUG=project-4yktn

# Interactive API docs (/docs, /redoc, /openapi.json). Off unless explicitly
# enabled -- they publish a full map of the API surface. Handy locally, pure
# reconnaissance value in production. Only 1/true/yes/on open them.
ENABLE_DOCS=true

# Only needed to run the integration test suite (backend/tests), which asserts
# on RLS policies and grants directly. Not read by application code.
# Use the session pooler string, not db.<ref>.supabase.co (IPv6-only).
# SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres
