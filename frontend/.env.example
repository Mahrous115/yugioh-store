# Copy this file to .env and replace the placeholders with your own values.
#
# ─── These variables are PUBLIC ─────────────────────────────────────────────
#
# Vite inlines every VITE_-prefixed variable into the JavaScript bundle at BUILD
# time. They are not secrets and cannot be: anyone who loads the site can read
# them straight out of the shipped JS. Only the publishable (anon) key belongs
# here. It is safe to expose because Row Level Security constrains what it can
# reach.
#
# The service-role key bypasses RLS entirely and must NEVER appear in this file,
# in this directory, or in any variable named VITE_*. It lives only in the
# backend's own environment (see backend/.env.example).
#
# ─── Build time, not run time ───────────────────────────────────────────────
#
# Because the values are baked into the bundle, changing one in a hosting
# dashboard has no effect until the project is REDEPLOYED. In Vercel the
# environments are ticked separately, so a variable set only for Production
# leaves Preview builds broken — set both.
#
# frontend/vite.config.js fails the build when a required variable below is
# missing, so this misconfiguration surfaces as a red deploy naming the variable
# rather than as a blank page in the browser.

# ─── Required. `npm run build` fails without these ──────────────────────────

# Your Supabase project URL.
VITE_SUPABASE_URL=https://your-project.supabase.co

# The publishable / anon key (Supabase dashboard -> Settings -> API).
# Public by design. NOT the service_role key.
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key-here

# ─── Optional, but set it for any deployed build ────────────────────────────

# Base URL of the FastAPI backend. Defaults to http://localhost:8000 when unset,
# which is correct locally and wrong everywhere else — a deployed frontend would
# ask the visitor's own machine for the API. The build warns when it is missing.
VITE_API_URL=http://localhost:8000
